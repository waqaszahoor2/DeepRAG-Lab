# ═══════════════════════════════════════════════════════════════
# DeepRAG Lab Frontend Environment Configuration (.env.local)
# ═══════════════════════════════════════════════════════════════

# Supabase Authentication Keys (from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API Endpoint URL (Optional for production; defaults to relative API paths)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NOTE: All AI provider keys (GEMINI_API_KEY, OPENROUTER_API_KEY) belong STRICTLY
# in the backend server environment (backend/.env) and MUST NEVER be exposed in frontend NEXT_PUBLIC_* variables.

