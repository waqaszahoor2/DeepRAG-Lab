# ═══════════════════════════════════════════════════════════════
# DeepRAG Lab Frontend Environment Configuration (.env.local)
# ═══════════════════════════════════════════════════════════════

# Supabase Authentication Keys (from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API Endpoint URL (local development only; not needed on Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── LLM API Keys (REQUIRED for AI chat to work) ─────────────
# Get your key from: https://openrouter.ai/keys
NEXT_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Google Gemini API key as a secondary fallback
# Get your key from: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=
