# ═══════════════════════════════════════════════════════════════
# DeepRAG Lab — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────
APP_NAME=DeepRAG Lab
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── LLM Providers (at least one required) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4-flash
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

LLM_PRIMARY_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ── Security ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/deeprag.db

# ── Vector Database ──────────────────────────────────────────
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=deeprag_documents

# Qdrant (for production — uncomment and set VECTOR_DB_PROVIDER=qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=deeprag_documents

# ── File Upload ──────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".csv",".md"]

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
